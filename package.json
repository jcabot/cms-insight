{
  "name": "cms-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "run-p dev:server dev:web",
    "dev:server": "pnpm --filter @cms-insight/server dev",
    "dev:web": "pnpm --filter @cms-insight/web dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
