# Example .env for cms-insight.
#
# This file is committed to the repo as a template. To actually use it,
# copy its contents into one of these locations (highest priority first):
#
#   1. The shell environment, e.g.   export ANTHROPIC_API_KEY=sk-ant-...
#   2. <contentDir>/.cmsinsight/.env  (per-project; already gitignored
#                                      via the auto-created .cmsinsight/)
#   3. ~/.cmsinsight/.env             (user-wide default; in your home,
#                                      not in any repo)
#
# Format: KEY=value, one per line. `#` starts a comment. Quotes optional.
# A leading `export ` is tolerated. Existing process.env values are never
# overwritten — the shell always wins.

# Required to enable AI suggestions on the broken-links page.
# Get one at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
